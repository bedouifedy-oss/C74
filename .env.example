# Database
DATABASE_URL=postgresql://username:password@localhost:5432/fixy_db

# Cron Job Security
CRON_SECRET=your-super-secret-cron-key-here

# SMS Configuration
SMS_PROVIDER_KEY=your-sms-provider-api-key
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+21612345678

# Webhook Security
WEBHOOK_SECRET=your-webhook-secret-key

# Service Communication
SERVICE_SECRET=your-internal-service-secret

# App Configuration
NEXT_PUBLIC_APP_URL=https://fixy.tn
NEXT_PUBLIC_API_URL=https://api.fixy.tn

# File Storage
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=eu-west-3
AWS_S3_BUCKET=fixy-uploads

# Email Configuration (for reports)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Analytics
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX

# Development
NODE_ENV=development
LOG_LEVEL=debug

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
